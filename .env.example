# Copy to .env and fill in locally. Never commit .env. Values are deliberately empty here.
# OpenAI (generation on /ask, the agent's router and tool decision, the RAGAS judge, embeddings)
OPENAI_API_KEY=
# Pinecone (retrieval)
PINECONE_API_KEY=
# Optional: LangSmith tracing
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=
LANGCHAIN_TRACING_V2=
# G10b approval gate: the SQLite file for paused reviews (unset = no checkpointer; a triggering question is refused)
REVIEW_DB_PATH=
# G11 provider seam (agent path generation only): openai (default) | bedrock
GENERATION_PROVIDER=
# Used only when GENERATION_PROVIDER=bedrock (local credentials; not repository secrets, not render.yaml)
BEDROCK_MODEL_ID=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
